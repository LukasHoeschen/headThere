    "\"%@\" will be permanently deleted." : {
      "comment" : "A confirmation message for a delete action. The argument is the name of the item to be deleted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ wird dauerhaft gelöscht."
          }
        }
      }
    },
    "\"%@\" will be permanently deleted. They'll also stop receiving your location." : {
      "comment" : "A message in the alert that appears when the user deletes a person. The argument is the name of the person to be deleted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ wird dauerhaft gelöscht. Die Person erhält deinen Standort dann auch nicht mehr."
          }
        }
      }
    },
    "A date is handy for something like a vacation spot: the compass will then show right next to the direction how long until it's time — like “in 2 weeks”." : {
      "comment" : "A description of the location section of the AddItemView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Datum ist z. B. bei einem Urlaubsziel praktisch: Der Kompass zeigt dann direkt neben der Richtung an, wie lange es noch dauert — etwa „in 2 Wochen“."
          }
        }
      }
    },
