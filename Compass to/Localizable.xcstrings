      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hinzugefügte Personen können deinen Standort nur sehen, während die Standortfreigabe aktiviert ist. Wird die Freigabe beendet, bleiben deine Verknüpfungen bestehen, aber die Übermittlung deines Standorts an sie wird pausiert, bis du die Freigabe fortsetzt."
