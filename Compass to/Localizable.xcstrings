    },
    "I develop Compass To on my own, alongside my studies. With Pro you directly support further development — and if you have questions, I answer personally." : {
      "comment" : "A description of the benefits of Pro.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ich entwickle Compass To ganz allein, neben meinem Studium. Mit Pro unterstützt du die Weiterentwicklung direkt — und wenn du Fragen hast, antworte ich persönlich."
          }
        }
      }
    },
