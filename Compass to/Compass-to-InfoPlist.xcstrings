    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Damit dein Standort auch mit deinen Personen geteilt werden kann, wenn HeadThere nicht geöffnet ist, wird dein Standort auch im Hintergrund bei größeren Ortsveränderungen aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "So your location can be shared with your people even when HeadThere isn't open, your location is also updated in the background on significant location changes."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "HeadThere benötigt deinen Standort, um Richtung und Entfernung zu gespeicherten Orten zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HeadThere needs your location to calculate direction and distance to saved places."
          }
        }
      }
    }
